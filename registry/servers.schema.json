{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP server registry",
  "type": "object",
  "required": ["servers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/server" }
    }
  },
  "definitions": {
    "server": {
      "type": "object",
      "required": ["name", "transport"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^[A-Za-z0-9]+([-_][A-Za-z0-9]+)*$",
          "description": "Used as the tool prefix (name__tool). No double underscores."
        },
        "transport": { "enum": ["stdio", "http"] },
        "enabled": { "type": "boolean" },
        "trusted": {
          "type": "boolean",
          "description": "Only trusted servers may have readOnlyHint honored (skips approval)."
        },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Names of environment variables to forward to a stdio server."
        },
        "url": { "type": "string", "pattern": "^https?://" },
        "auth": {
          "type": "object",
          "required": ["type", "env"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["bearer"] },
            "env": { "type": "string" }
          }
        },
        "call_timeout_s": { "type": "number", "exclusiveMinimum": 0 },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "stdio" } }, "required": ["transport"] },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "transport": { "const": "http" } }, "required": ["transport"] },
          "then": { "required": ["url"] }
        }
      ]
    }
  }
}